# Copy to .env (never commit it). See docs/OPERATIONS.md for what each one does.

# --- required ---
GEMINI_API_KEY=
POSTGRES_PASSWORD=change-me

# --- URLs ---
FRONTEND_URL=http://localhost:3000            # used in sign-in links
NEXT_PUBLIC_API_URL=http://localhost:8000     # baked into the frontend build
# CORS_ORIGINS=https://staging.example.com    # extra allowed origins, comma-separated

# --- sign-in email (pick one; with neither, links are only logged) ---
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="ZodicogAI <login@yourdomain.com>"
# AUTH_DEV_LINKS=1                            # dev/CI only: returns the link in the API response

# --- monitoring / analytics (all optional; inert when empty) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# METRICS_TOKEN=                              # protects GET /metrics

# --- tuning ---
# GEMINI_MAX_CONCURRENT=8
# GEMINI_SLOT_WAIT_SECONDS=45
