# Reference reverse-proxy config for the VPS (also fine behind Cloudflare).
# Adjust server_name, certificate paths and upstream ports, then include it from
# /etc/nginx/conf.d/ or sites-enabled/.

# Trust Cloudflare's forwarded client IP so the backend's per-IP AI budget and
# sign-in limits see real visitors. Keep this list current:
# https://www.cloudflare.com/ips/   (set_real_ip_from ... for each range)
# set_real_ip_from 173.245.48.0/20;
# set_real_ip_from 103.21.244.0/22;
# ... (remaining ranges)
# real_ip_header CF-Connecting-IP;

upstream zodicog_frontend { server 127.0.0.1:3000; keepalive 16; }
upstream zodicog_backend  { server 127.0.0.1:8000; keepalive 16; }

server {
    listen 80;
    server_name zodicogai.com www.zodicogai.com api.zodicogai.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name zodicogai.com www.zodicogai.com;

    ssl_certificate     /etc/ssl/zodicog/origin.pem;      # e.g. a Cloudflare Origin Certificate
    ssl_certificate_key /etc/ssl/zodicog/origin.key;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Hashed build assets: cache for a year.
    location /_next/static/ {
        proxy_pass http://zodicog_frontend;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://zodicog_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}

server {
    listen 443 ssl http2;
    server_name api.zodicogai.com;

    ssl_certificate     /etc/ssl/zodicog/origin.pem;
    ssl_certificate_key /etc/ssl/zodicog/origin.key;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 1m;

    location / {
        proxy_pass http://zodicog_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Server-sent events (streamed readings and chat): never buffer.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
